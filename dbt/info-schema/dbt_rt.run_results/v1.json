{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getdbt.com/dbt/info-schema/dbt_rt.run_results/v1.json",
  "title": "dbt_rt.run_results",
  "description": "Primary key: `unique_id`, `invocation_id`.",
  "type": "object",
  "x-primary-key": [
    "unique_id",
    "invocation_id"
  ],
  "properties": {
    "unique_id": {
      "type": [
        "string",
        "null"
      ],
      "x-primary-key": true,
      "x-references": [
        {
          "table": "dbt.dag_nodes",
          "column": "unique_id",
          "unique": false
        }
      ],
      "description": "Part of the primary key. References `dbt.dag_nodes.unique_id`. The id of a hook is not in `dbt.dag_nodes`."
    },
    "invocation_id": {
      "type": [
        "string",
        "null"
      ],
      "x-primary-key": true,
      "x-references": [
        {
          "table": "dbt_rt.invocations",
          "column": "invocation_id",
          "unique": true
        }
      ],
      "description": "Part of the primary key. References `dbt_rt.invocations.invocation_id`."
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_time": {
      "type": [
        "number",
        "null"
      ]
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "failures": {
      "type": [
        "integer",
        "null"
      ]
    },
    "relation_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "adapter_response": {
      "type": [
        "string",
        "null"
      ]
    },
    "timing": {
      "type": [
        "string",
        "null"
      ]
    },
    "batch_results": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}

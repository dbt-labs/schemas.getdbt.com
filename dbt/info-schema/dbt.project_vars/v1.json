{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getdbt.com/dbt/info-schema/dbt.project_vars/v1.json",
  "title": "dbt.project_vars",
  "description": "Primary key: `project_name`, `var_name`.",
  "type": "object",
  "x-primary-key": [
    "project_name",
    "var_name"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "x-primary-key": true,
      "description": "Part of the primary key."
    },
    "var_name": {
      "type": "string",
      "x-primary-key": true,
      "description": "Part of the primary key."
    },
    "var_value": {
      "type": "string"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

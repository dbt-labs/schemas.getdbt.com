{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getdbt.com/dbt/info-schema/dbt.seeds/v1.json",
  "title": "dbt.seeds",
  "description": "Primary key: `unique_id`.",
  "type": "object",
  "x-primary-key": [
    "unique_id"
  ],
  "properties": {

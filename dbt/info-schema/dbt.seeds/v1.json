        "type": "string"
      }
    },
    "meta": {
      "type": "string"
    },
    "grain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grain_declared": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grain_tested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "grain_inferred": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    }

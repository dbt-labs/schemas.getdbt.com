    },
    "resource_type": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "original_file_path": {
      "type": "string"
    },
    "fqn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alias": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "database_name": {
      "type": "string"
    },
    "schema_name": {
      "type": "string"
    },
    "relation_name": {
      "type": "string"
    },
    "identifier": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "full_refresh": {
      "type": "boolean"
    },
    "persist_docs": {
      "type": "string"
    },
    "pre_hook": {
      "type": "string"
    },
    "post_hook": {
      "type": "string"
    },
    "grants": {
      "type": "string"
    },
    "config": {
      "type": "string"
    },
    "group": {
      "type": "string"
    },
    "docs_show": {
      "type": "boolean"
    },
    "properties_yml_file_path": {
      "type": "string"

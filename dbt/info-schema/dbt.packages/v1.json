{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getdbt.com/dbt/info-schema/dbt.packages/v1.json",
  "title": "dbt.packages",
  "description": "Primary key: `package_name`.",
  "type": "object",
  "x-primary-key": [
    "package_name"
  ],
  "properties": {
    "package_name": {
      "type": [
        "string",
        "null"
      ],
      "x-primary-key": true,
      "description": "Part of the primary key."
    },
    "package_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "local_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getdbt.com/dbt/info-schema/dbt.hooks/v1.json",
  "title": "dbt.hooks",
  "description": "Primary key: `unique_id`.",
  "type": "object",
  "x-primary-key": [
    "unique_id"
  ],
  "properties": {
    "unique_id": {
      "type": "string",
      "x-primary-key": true,
      "description": "Part of the primary key."
    },
    "name": {
      "type": "string"
    },
    "resource_type": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "original_file_path": {
      "type": "string"
    },
    "fqn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "node_language": {
      "type": "string"
    },
    "raw_code": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "compiled_code": {
      "type": "string"
    },
    "compiled_path": {
      "type": "string"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
